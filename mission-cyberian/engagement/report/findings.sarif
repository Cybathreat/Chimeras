          "ruleId": "CHIMERAS-blo-001",
          "level": "error",
          "message": {
            "text": "OpenSSH 9.6p1 Ubuntu 3ubuntu13.18 falls within CVE-2024-6387 affected range (8.5p1<=9.7p1). Race condition in signal handler allows unauthenticated RCE.\n\nPoC: nmap -sV -p 22 --script ssh2-enum-algos -Pn cyberian-defenses.com (version confirmed as 9.6p1)\n\nProof: PORT 22/tcp open ssh OpenSSH 9.6p1 Ubuntu 3ubuntu13.18 (Ubuntu Linux; protocol 2.0). CVE-2024-6387 affects 8.5p1 through 9.7p1."
          },
          "logicalLocations": [
            {
              "name": "cyberian-defenses.com (76.13.46.223):22:ssh",
              "fullyQualifiedName": "endpoint/cyberian-defenses.com (76.13.46.223):22:ssh"
            }
          ],
          "properties": {
            "strix": {
              "severity": "critical",
              "cvss": 8.1,
              "cvss_vector": null,
              "cve": null,
              "cwe": null,
              "status": "Probable",
              "host": "cyberian-defenses.com (76.13.46.223)",
              "port": 22,
              "service": "ssh",
              "finding_id": "BLO-001",
              "discovered_by": null,
              "security-severity": "8.1"
            }
          },
          "fixes": [
            {
              "description": {
                "text": "Patch OpenSSH to 9.8p1 or later, or apply vendor backport patch for Ubuntu."
              }
            }
          ]
        },
