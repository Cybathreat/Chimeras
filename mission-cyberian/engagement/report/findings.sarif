  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Chimeras",
          "version": "3.0.0",
          "informationUri": "https://github.com/Cybathreat/Chimeras",
          "rules": [
            {
              "id": "CHIMERAS-blo-001",
              "name": "OpenSSH 9.6p1 — CVE-2024-6387 (regreSSHion) RCE",
              "shortDescription": {
                "text": "OpenSSH 9.6p1 — CVE-2024-6387 (regreSSHion) RCE"
              },
              "fullDescription": {
                "text": "OpenSSH 9.6p1 Ubuntu 3ubuntu13.18 falls within CVE-2024-6387 affected range (8.5p1<=9.7p1). Race condition in signal handler allows unauthenticated RCE."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "precision": "medium",
                "security-severity": "8.1"
              }
            },
            {
              "id": "CHIMERAS-blo-002",
              "name": "Weak SSH MAC algorithms (hmac-sha1) enabled",
              "shortDescription": {
                "text": "Weak SSH MAC algorithms (hmac-sha1) enabled"
              },
              "fullDescription": {
                "text": "SSH server accepts hmac-sha1 and hmac-sha1-etm MAC algorithms, which use SHA-1 — a deprecated hash with known collision vulnerabilities."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "precision": "medium",
                "security-severity": "5.9"
              }
            },
            {
              "id": "CHIMERAS-blo-003",
              "name": "SSH password authentication enabled",
              "shortDescription": {
                "text": "SSH password authentication enabled"
              },
              "fullDescription": {
                "text": "SSH server accepts both publickey and password authentication methods. Password auth enables brute-force and credential stuffing attacks."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "precision": "medium",
                "security-severity": "5.3"
              }
            },
            {
              "id": "CHIMERAS-blo-004",
              "name": "CSP allows 'unsafe-inline' for scripts and styles",
              "shortDescription": {
                "text": "CSP allows 'unsafe-inline' for scripts and styles"
              },
              "fullDescription": {
                "text": "Content-Security-Policy header includes 'unsafe-inline' in both script-src and style-src directives, significantly weakening XSS protection."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "precision": "medium",
                "security-severity": "5.4"
              }
            },
            {
